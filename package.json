{
  "name": "matemagica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run grafo:check && vite build && esbuild ./server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "coverage:matrix": "vitest run src/curriculum/coverageMatrix.test.ts --silent=false",
    "coverage:matrix:markdown": "SAGA_COVERAGE_FORMAT=markdown vitest run src/curriculum/coverageMatrix.test.ts --silent=false",
    "coverage:matrix:json": "SAGA_COVERAGE_FORMAT=json vitest run src/curriculum/coverageMatrix.test.ts --silent=false",
    "auditar": "node AI_Studio_Lab/tools/catalog_auditor.cjs && node AI_Studio_Lab/tools/canonical_doc_guard.cjs && node AI_Studio_Lab/tools/composite_stage_auditor.cjs && npm run coverage:matrix",
    "fichas:auditar": "node AI_Studio_Lab/tools/ficha_catalog_auditor.cjs",
    "grafo:gerar": "node scripts/generate-graph-artifacts.cjs",
    "grafo:check": "node scripts/generate-graph-artifacts.cjs --check",
    "grafo:codigo": "graphify update . && graphify cluster-only .",
    "pr:check": "node AI_Studio_Lab/tools/pr_text_guard.cjs",
    "simular": "tsx simulated-learner-real.ts",
    "contrato": "vitest run",
    "sonda": "node scripts/sonda-layout.mjs",
    "sonda:sensei-dojo": "node scripts/sonda-sensei-dojo.mjs && node scripts/sonda-matricula.mjs",
    "sonda:reta20": "node scripts/sonda-reta20.mjs",
    "sonda:regua": "node scripts/sonda-regua.mjs",
    "sonda:comparacao-simbolica": "node scripts/sonda-comparacao.mjs",
    "sonda:quadrado100": "node scripts/sonda-quadrado100.mjs",
    "sonda:visual-addition": "node scripts/sonda-visual-addition.mjs",
    "sonda:emojirow-riscar": "node scripts/sonda-emojirow-riscar.mjs",
    "sonda:counting-on": "node scripts/sonda-counting-on.mjs",
    "sonda:skip-count": "node scripts/sonda-skip-count.mjs",
    "sonda:equal-groups": "node scripts/sonda-equal-groups.mjs",
    "fichas:conferir": "vitest run src/curriculum/conformidadeDeFichas.test.ts --silent=false"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.12.1",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
